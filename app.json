{
  "expo": {
    "name": "CareerOn",
    "slug": "careeron",
    "version": "1.0.0",
    "scheme": "careeron",
    "orientation": "portrait",
    "icon": "./assets/logocarre.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/logocarre.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logocarre.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/logocarre.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-speech-recognition",
      "@react-native-voice/voice"
    ]
  }
}
